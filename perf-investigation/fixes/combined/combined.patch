+/* --leave só é lida pela própria .scroll-fade (opacity/filter/transform).
+   Registrada como NÃO herdada: cada escrita do JS recalcula só a seção,
+   não a subárvore inteira (custom properties comuns herdam para todos
+   os descendentes). Mesmo valor inicial (0) que a regra abaixo. */
+@property --leave { syntax: '<number>'; inherits: false; initial-value: 0; }
 .scroll-fade {
   --leave: 0;
   opacity: calc(1 - var(--leave));
